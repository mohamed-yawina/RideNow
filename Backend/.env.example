# Copy to .env and replace the placeholders. Never commit actual credentials.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=replace_with_your_supabase_key
SECRET_KEY=replace_with_a_long_random_jwt_signing_secret
# Comma-separated browser origins, e.g. http://localhost:3000,http://localhost:5173
# Native Android clients do not require browser CORS configuration.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
