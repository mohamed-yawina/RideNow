<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp"
    android:background="@drawable/bg_dialog">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="🔄 Recherche de client"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="#00E676"
        android:layout_gravity="center"
        android:layout_marginBottom="16dp"/>

    <TextView
        android:id="@+id/tvMatchingClientName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Client"
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="#FFFFFF"
        android:layout_marginBottom="8dp"/>

    <TextView
        android:id="@+id/tvMatchingDestination"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Destination"
        android:textSize="14sp"
        android:textColor="#8E9AAF"
        android:layout_marginBottom="16dp"/>

    <TextView
        android:id="@+id/tvMatchingTimer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="30s"
        android:textSize="48sp"
        android:textStyle="bold"
        android:textColor="#FF5252"
        android:layout_gravity="center"
        android:layout_marginBottom="8dp"/>

    <TextView
        android:id="@+id/tvMatchingStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="⏳ En attente du client..."
        android:textSize="13sp"
        android:textColor="#8E9AAF"
        android:layout_gravity="center"
        android:layout_marginBottom="20dp"/>

    <Button
        android:id="@+id/btnCancelMatching"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:text="Annuler"
        android:backgroundTint="#FF5252"
        android:textColor="#FFFFFF"
        android:textAllCaps="false"/>

</LinearLayout>