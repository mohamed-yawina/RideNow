<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0A0E17">

    <!-- Carte -->
    <org.osmdroid.views.MapView
        android:id="@+id/mapView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- Header -->
    <androidx.cardview.widget.CardView
        android:id="@+id/cardTopBar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        android:layout_marginTop="16dp"
        app:cardCornerRadius="24dp"
        app:cardBackgroundColor="#1E2433"
        app:cardElevation="8dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="12dp"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tvWelcome"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Bonjour 👋"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:layout_marginStart="8dp"/>

            <ImageView
                android:id="@+id/btnLogout"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@drawable/ic_logout"
                android:padding="10dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Déconnexion"/>
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <!-- Zone de recherche de chauffeur (pendant la recherche) -->
    <androidx.cardview.widget.CardView
        android:id="@+id/cardSearching"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        android:visibility="gone"
        app:cardCornerRadius="20dp"
        app:cardBackgroundColor="#1E2433"
        app:cardElevation="16dp"
        app:layout_constraintTop_toBottomOf="@id/cardTopBar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp"
            android:gravity="center">

            <ProgressBar
                android:id="@+id/progressBarSearch"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:indeterminateTint="#00E676"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Recherche d'un chauffeur..."
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="#00E676"
                android:layout_marginTop="16dp"/>

            <TextView
                android:id="@+id/tvSearchStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="En attente d'un chauffeur"
                android:textSize="13sp"
                android:textColor="#8E9AAF"
                android:layout_marginTop="8dp"/>

            <Button
                android:id="@+id/btnCancelSearch"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:layout_marginTop="16dp"
                android:text="Annuler la recherche"
                android:textColor="#FF5252"
                android:background="@android:color/transparent"/>
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <!-- Dialog d'offre du chauffeur -->
    <androidx.cardview.widget.CardView
        android:id="@+id/cardDriverOffer"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        android:visibility="gone"
        app:cardCornerRadius="20dp"
        app:cardBackgroundColor="#1E2433"
        app:cardElevation="16dp"
        app:layout_constraintTop_toBottomOf="@id/cardTopBar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🚖"
                    android:textSize="28sp"/>

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Nouvelle offre !"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="#00E676"
                    android:layout_marginStart="12dp"/>

                <TextView
                    android:id="@+id/tvOfferTimer"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="30s"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="#FF5252"/>
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#2A3441"
                android:layout_marginVertical="12dp"/>

            <!-- Info Chauffeur -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="16dp">

                <TextView
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="@drawable/bg_avatar"
                    android:text="👨‍✈️"
                    android:textSize="24sp"
                    android:gravity="center"
                    android:layout_marginEnd="12dp"/>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvOfferDriverName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Chauffeur"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="#FFFFFF"/>

                    <TextView
                        android:id="@+id/tvOfferDriverVehicle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Véhicule"
                        android:textSize="12sp"
                        android:textColor="#8E9AAF"/>
                </LinearLayout>

                <TextView
                    android:id="@+id/tvOfferDriverRating"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="★ 4.5"
                    android:textSize="13sp"
                    android:textColor="#FFD700"
                    android:background="#1C2128"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:paddingTop="4dp"
                    android:paddingBottom="4dp"/>
            </LinearLayout>

            <!-- Itinéraire -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="12dp">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center_horizontal"
                    android:layout_marginEnd="12dp">

                    <View
                        android:layout_width="10dp"
                        android:layout_height="10dp"
                        android:background="@drawable/bg_dot_green"/>

                    <View
                        android:layout_width="2dp"
                        android:layout_height="20dp"
                        android:background="#2A3441"/>

                    <View
                        android:layout_width="10dp"
                        android:layout_height="10dp"
                        android:background="@drawable/bg_dot_red"/>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Départ"
                        android:textSize="10sp"
                        android:textColor="#8E9AAF"/>

                    <TextView
                        android:id="@+id/tvOfferPickup"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Chargement..."
                        android:textSize="13sp"
                        android:textColor="#F0F6FC"
                        android:layout_marginBottom="12dp"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Destination"
                        android:textSize="10sp"
                        android:textColor="#8E9AAF"/>

                    <TextView
                        android:id="@+id/tvOfferDestination"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Chargement..."
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:textColor="#F0F6FC"/>
                </LinearLayout>
            </LinearLayout>

            <!-- Prix -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="#2A3441"
                android:padding="12dp"
                android:layout_marginTop="8dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="💰 Prix proposé"
                    android:textSize="12sp"
                    android:textColor="#8E9AAF"/>

                <TextView
                    android:id="@+id/tvOfferPrice"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="0 MAD"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="#00E676"
                    android:gravity="end"/>
            </LinearLayout>

            <!-- Boutons -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="16dp"
                android:weightSum="2">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnRefuseOffer"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="8dp"
                    android:text="REFUSER"
                    android:textColor="#FF5252"
                    app:strokeColor="#FF5252"
                    app:cornerRadius="14dp"/>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnAcceptOffer"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp"
                    android:text="ACCEPTER"
                    android:textColor="#000000"
                    app:backgroundTint="#00E676"
                    app:cornerRadius="14dp"/>
            </LinearLayout>

        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <!-- Course en cours -->
    <androidx.cardview.widget.CardView
        android:id="@+id/cardActiveRide"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        android:visibility="gone"
        app:cardCornerRadius="20dp"
        app:cardBackgroundColor="#1E2433"
        app:cardElevation="16dp"
        app:layout_constraintTop_toBottomOf="@id/cardTopBar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🚗"
                    android:textSize="28sp"/>

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Course en cours"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="#00E676"
                    android:layout_marginStart="12dp"/>

                <TextView
                    android:id="@+id/tvRideStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Acceptée"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="#FF9800"/>
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#2A3441"
                android:layout_marginVertical="12dp"/>

            <!-- Info Chauffeur -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="16dp">

                <TextView
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="@drawable/bg_avatar"
                    android:text="👨‍✈️"
                    android:textSize="24sp"
                    android:gravity="center"
                    android:layout_marginEnd="12dp"/>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvActiveDriverName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Chauffeur"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="#FFFFFF"/>

                    <TextView
                        android:id="@+id/tvActiveDriverVehicle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Véhicule"
                        android:textSize="12sp"
                        android:textColor="#8E9AAF"/>
                </LinearLayout>

                <TextView
                    android:id="@+id/tvActiveDriverRating"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="★ 4.5"
                    android:textSize="13sp"
                    android:textColor="#FFD700"
                    android:background="#1C2128"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:paddingTop="4dp"
                    android:paddingBottom="4dp"/>
            </LinearLayout>

            <!-- Itinéraire -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="12dp">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center_horizontal"
                    android:layout_marginEnd="12dp">

                    <View
                        android:layout_width="10dp"
                        android:layout_height="10dp"
                        android:background="@drawable/bg_dot_green"/>

                    <View
                        android:layout_width="2dp"
                        android:layout_height="20dp"
                        android:background="#2A3441"/>

                    <View
                        android:layout_width="10dp"
                        android:layout_height="10dp"
                        android:background="@drawable/bg_dot_red"/>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Départ"
                        android:textSize="10sp"
                        android:textColor="#8E9AAF"/>

                    <TextView
                        android:id="@+id/tvActivePickup"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Chargement..."
                        android:textSize="13sp"
                        android:textColor="#F0F6FC"
                        android:layout_marginBottom="12dp"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Destination"
                        android:textSize="10sp"
                        android:textColor="#8E9AAF"/>

                    <TextView
                        android:id="@+id/tvActiveDestination"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Chargement..."
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:textColor="#F0F6FC"/>
                </LinearLayout>
            </LinearLayout>

            <!-- Prix -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="#2A3441"
                android:padding="12dp"
                android:layout_marginTop="8dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="💰 Prix"
                    android:textSize="12sp"
                    android:textColor="#8E9AAF"/>

                <TextView
                    android:id="@+id/tvActivePrice"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="0 MAD"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="#00E676"
                    android:gravity="end"/>
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCompleteActiveRide"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="16dp"
                android:text="🏁 TERMINER LA COURSE"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="#000000"
                app:backgroundTint="#FF9800"
                app:cornerRadius="14dp"/>
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <!-- Bottom Sheet pour demande de course -->
    <androidx.cardview.widget.CardView
        android:id="@+id/cardBottom"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        app:cardCornerRadius="28dp"
        app:cardBackgroundColor="#1E2433"
        app:cardElevation="16dp"
        app:layout_constraintBottom_toTopOf="@id/bottomNavigation"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Où allez-vous ?"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"/>

            <!-- Destination -->
            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                app:boxStrokeColor="#00E676"
                app:boxBackgroundColor="#2A3441"
                app:hintEnabled="false"
                app:startIconDrawable="@drawable/ic_mylocation"
                app:startIconTint="#00E676"
                app:endIconMode="clear_text"
                app:endIconTint="#8E9AAF">

                <AutoCompleteTextView
                    android:id="@+id/etDestination"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:hint="Saisissez votre destination..."
                    android:textColor="#FFFFFF"
                    android:textColorHint="#8E9AAF"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:textSize="15sp"
                    android:background="@null"
                    android:completionThreshold="1"/>
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Prix -->
            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                app:boxStrokeColor="#00E676"
                app:boxBackgroundColor="#2A3441"
                app:hintEnabled="false"
                app:startIconDrawable="@drawable/ic_price"
                app:startIconTint="#00E676"
                app:endIconMode="clear_text"
                app:endIconTint="#8E9AAF">

                <EditText
                    android:id="@+id/etPrice"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:hint="Votre prix proposé (MAD)"
                    android:textColor="#FFFFFF"
                    android:textColorHint="#8E9AAF"
                    android:inputType="number"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:textSize="15sp"
                    android:background="@null"/>
            </com.google.android.material.textfield.TextInputLayout>

            <TextView
                android:id="@+id/tvPriceHint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="💰 Prix suggéré: ~30 MAD"
                android:textSize="11sp"
                android:textColor="#8E9AAF"
                android:layout_marginTop="8dp"
                android:layout_marginStart="12dp"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnRequestRide"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="24dp"
                android:text="DEMANDER UN TRAJET"
                android:textSize="16sp"
                android:textStyle="bold"
                app:backgroundTint="#00E676"
                app:cornerRadius="16dp"
                android:elevation="4dp"
                android:enabled="false"/>
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <!-- Bouton localisation -->
    <androidx.cardview.widget.CardView
        android:id="@+id/btnMyLocation"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="16dp"
        app:cardCornerRadius="24dp"
        app:cardElevation="6dp"
        app:cardBackgroundColor="#1E2433"
        android:clickable="true"
        android:focusable="true"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toTopOf="@id/bottomNavigation">

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_mylocation"
            android:tint="#00E676"
            android:contentDescription="Ma position"/>
    </androidx.cardview.widget.CardView>

    <!-- Bottom Navigation -->
    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNavigation"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="#1E2433"
        app:itemIconTint="@color/bottom_nav_selector"
        app:itemTextColor="@color/bottom_nav_selector"
        app:menu="@menu/menu_client_bottom_nav"
        app:elevation="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- Fragment container -->
    <FrameLayout
        android:id="@+id/fragmentContainer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/bottomNavigation"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>